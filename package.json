{
  "name": "kotopes",
  "version": "1.0.0",
  "scripts": {
    "start": "node server/index.js",
    "dev": "concurrently \"npm start\" \"cd client && npm run dev\"",
    "build": "cd client && npm run build",
    "build:prod": "npm run build && npm start",
    "images:optimize": "node scripts/optimize-images.js",
    "stats": "node server/stats/emailStats.js",
    "stats:scheduler": "node server/stats/scheduler.js"
  },
  "dependencies": {
    "sharp": "^0.32.4"
  },
  "devDependencies": {
    "canvas": "^3.2.0",
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  }
}
